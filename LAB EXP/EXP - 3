
import heapq
def ucs(graph,start,goal):
    queue=[(0,start,[start])]
    visited=set()
    while queue:
        cost,node,path=heapq.heappop(queue)
        if node==goal:
            return cost,path
        if node not in visited:
            visited.add(node)
            for neighbour,travel_cost in graph[node]:
                if neighbour not in visited:
                    heapq.heappush(queue,(cost+travel_cost,neighbour,path+[neighbour]))
    return None,None
graph={
    'A':[('B',4),('C',2)],
    'B':[('A',4),('D',5),('E',10)],
    'C':[('A',2),('D',8),('E',3)],
    'D':[('B',5),('C',8),('F',6)],
    'E':[('B',10),('C',3),('F',2)],
    'F':[('D',6),('E',2)]
}
print("Transportation Cost Finder using UCS")
start=input("Enter starting location (A-F): ").upper()
goal=input("Enter destination location (A-F): ").upper()
if start not in graph or goal not in graph:
    print("Invalid location! Enter a location from A to F.")
else:
    cost,path=ucs(graph,start,goal)
    if path:
        print("Least-cost route:"," -> ".join(path))
        print("Total transportation cost:",cost)
    else:
        print("No route found.")
